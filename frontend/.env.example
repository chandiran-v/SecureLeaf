VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Phase 9, D9 — only needed when nothing in front of this app proxies /graphql and /api to the
# backend (i.e. a static Vercel deployment, where the frontend and backend are different origins).
# Leave both unset for local dev (Vite's proxy, see vite.config.ts) and for the Docker Compose
# deployment (nginx's proxy, see infra/nginx/nginx.conf) — both already forward the relative paths.
# VITE_GRAPHQL_URL=https://secureleaf-backend.onrender.com/graphql
# VITE_API_URL=https://secureleaf-backend.onrender.com/api
