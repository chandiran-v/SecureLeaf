name: E2E smoke test

# Phase 9, D8 — the MVP1 golden path against a real, fully running stack (Postgres, Redis, MinIO,
# the Spring Boot backend, and the built frontend). This is delivered as a `*.example` file, not a
# live workflow: the automation that builds each phase is not allowed to add or edit anything
# under `.github/workflows/` (see docs/phases/phase-09-hardening-release.md). Copy this file to
# `.github/workflows/e2e.yml` to turn it on.
#
# WHY THIS ISN'T PART OF backend-ci.yml / frontend-ci.yml
# Those two jobs test each side in isolation (backend: mvn verify against Testcontainers; frontend:
# lint/typecheck/unit tests against mocked GraphQL). This workflow is the only one that boots every
# real dependency and both apps together and drives them from an actual browser — it's slower and
# answers a different question ("does the whole system work together"), so it runs as its own job.

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  e2e:
    name: MVP1 golden path (Playwright)
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
          cache: maven

      - name: Set up Node 20
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: |
            frontend/package-lock.json
            e2e/package-lock.json

      # Postgres + Redis + MinIO — the same images infra/docker-compose.yml uses for local dev.
      # MinIO's official image lives on quay.io, not docker.io; some restricted/offline CI runners
      # cannot reach it (this is exactly what blocked a fully automated run of this suite in the
      # sandbox this phase was built in — see docs/release-mvp1.md's D8 entry). A normal GitHub-
      # hosted runner has unrestricted internet access and pulls it fine.
      - name: Start infra (Postgres, Redis, MinIO)
        run: docker compose -f infra/docker-compose.yml up -d postgres redis minio minio-init

      - name: Wait for infra to be healthy
        run: |
          for i in $(seq 1 30); do
            docker compose -f infra/docker-compose.yml ps --format json | grep -q '"Health":"healthy"' && break
            sleep 2
          done

      - name: Build backend
        working-directory: backend
        run: ./mvnw -q -DskipTests package

      - name: Start backend
        working-directory: backend
        run: nohup java -jar target/*.jar --spring.profiles.active=dev > /tmp/backend.log 2>&1 &
        env:
          ADMIN_EMAILS: ''
          NOTIFICATION_EMAIL_ENABLED: 'false'

      - name: Wait for backend readiness
        run: |
          for i in $(seq 1 30); do
            curl -sf http://localhost:8080/actuator/health/readiness && break
            sleep 2
          done

      - name: Install frontend dependencies
        working-directory: frontend
        run: npm ci

      - name: Start frontend (dev server — same proxy setup a real developer uses)
        working-directory: frontend
        run: nohup npm run dev -- --port 5173 > /tmp/frontend.log 2>&1 &

      - name: Wait for frontend
        run: |
          for i in $(seq 1 30); do
            curl -sf http://localhost:5173 && break
            sleep 1
          done

      - name: Install e2e dependencies
        working-directory: e2e
        run: npm ci

      - name: Install Playwright browsers
        working-directory: e2e
        run: npx playwright install --with-deps chromium

      - name: Run the E2E smoke test
        working-directory: e2e
        run: npm run e2e
        env:
          CI: true

      - name: Upload Playwright report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: e2e/playwright-report/
          retention-days: 14

      - name: Upload backend/frontend logs on failure
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: server-logs
          path: |
            /tmp/backend.log
            /tmp/frontend.log
