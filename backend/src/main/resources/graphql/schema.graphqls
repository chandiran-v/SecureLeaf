# SecureLeaf — GraphQL Schema
# Split into logical files per module as the schema grows.
# Spring for GraphQL auto-discovers all .graphqls files under classpath:graphql/

# ── Scalars ──────────────────────────────────────────────────────────────────
scalar DateTime
scalar BigDecimal
# 64-bit integer. GraphQL's built-in Int is signed 32-bit (max 2,147,483,647 paise = ₹2.14 crore),
# too small for aggregated money like a creator's lifetime earnings.
scalar Long

# ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
    BUYER
    CREATOR
    ADMIN
}

enum EntitlementStatus {
    ACTIVE
    REVOKED
    EXPIRED
}


enum ProductStatus {
    DRAFT
    PROCESSING
    LIVE
    UNPUBLISHED
    FAILED
}

enum OrderStatus {
    PENDING
    COMPLETED
    FAILED
    REFUNDED
}

# D4 — what a viewerHeartbeat call finds: still leased by us, taken over by a newer session
# (D3), or the lease lapsed.
enum ViewerSessionStatus {
    ACTIVE
    SUPERSEDED
    EXPIRED
}

# Mirrors com.secureleaf.creator.entity.JobStage — the processing pipeline's 5 stages
# (Phase 6, D4). Surfaced on Product so the creator dashboard can show exactly where a
# PROCESSING product currently is, not just the fact that it's processing.
enum JobStage {
    VALIDATE
    CONVERT_TILES
    GENERATE_THUMBNAIL
    GENERATE_PREVIEW
    MARK_LIVE
}

# ── Types ─────────────────────────────────────────────────────────────────────

type User {
    id: ID!
    email: String!
    displayName: String!
    roles: [UserRole!]!
    createdAt: DateTime!
}

type Product {
    id: ID!
    title: String!
    description: String!
    pricePaise: Int!
    status: ProductStatus!
    creator: CreatorSummary!
    category: Category!
    tags: [String!]!
    thumbnailUrl: String
    averageRating: Float
    totalSales: Int!
    freePreviewPages: Int!
    pageCount: Int
    createdAt: DateTime!
    # True when the current user holds an ACTIVE entitlement. Always false for anonymous visitors.
    # Resolved in one batched query per request (@BatchMapping), never once per product.
    ownedByMe: Boolean!
    # Phase 6, D2 — creator-only. Null for every viewer except the product's own creator (checked
    # in the resolver, not by the client), so the schema itself can't be asked to leak another
    # creator's numbers. Both fields share one aggregate query per request via a named DataLoader.
    salesCount: Int
    netEarningsPaise: Long
    # Phase 6, D4 — creator-dashboard-only detail. Null unless the product is currently
    # PROCESSING (processingStage) or FAILED (failureReason).
    processingStage: JobStage
    failureReason: String
    # Phase 8, D5 — set only when an admin's takeDownProduct moved this LIVE product to
    # UNPUBLISHED. Null for a creator's own unpublishProduct. The creator dashboard uses
    # this (not status alone) to show why, and to hide the Republish button — a creator
    # can never republish past an admin takedown, only an admin's restoreProduct reverses it.
    takedownReason: String
}

# Public-safe projection of a product's creator — never exposes email.
type CreatorSummary {
    id: ID!
    displayName: String!
}

type Category {
    id: ID!
    name: String!
    slug: String!
}

type ProductPage {
    content: [Product!]!
    totalElements: Int!
    totalPages: Int!
    pageNumber: Int!
}

type Review {
    id: ID!
    reviewer: ReviewerSummary!
    rating: Int!
    reviewText: String
    createdAt: DateTime!
    updatedAt: DateTime!
}

# D5 — the reviewer's public-safe projection. Deliberately narrower than CreatorSummary
# (no id): a review is displayed with a name only, never with anything that could be used
# to look the buyer up.
type ReviewerSummary {
    displayName: String!
}

type ReviewPage {
    content: [Review!]!
    totalElements: Int!
    totalPages: Int!
    pageNumber: Int!
}

# D6 — one row per star value, always all five (0 counts included), for the histogram.
type RatingCount {
    rating: Int!
    count: Int!
}

type Entitlement {
    id: ID!
    product: Product!
    purchasedAt: DateTime!
    status: EntitlementStatus!
    # Phase 15, D4 — the version this purchase reads ("v2"), and whether the product now has a newer
    # CURRENT version the buyer does NOT have. Informational only: no upgrade purchase exists yet.
    versionNumber: Int!
    newEditionAvailable: Boolean!
}

# Phase 15, D7 — one row of the creator's version history.
enum UpdatePolicy { NEW_BUYERS_ONLY FREE_UPDATE_FOR_EXISTING }
enum DocumentVersionStatus { PROCESSING READY FAILED RETIRED }

type DocumentVersion {
    id: ID!
    versionNumber: Int!
    createdAt: DateTime!
    pageCount: Int
    status: DocumentVersionStatus!
    updatePolicy: UpdatePolicy!
    # ACTIVE entitlements currently pinned to this version
    buyerCount: Int!
    current: Boolean!
    failureReason: String
    # True while a FREE_UPDATE_FOR_EXISTING batch migration has entitlements left to move
    migrationPending: Boolean!
}

# MVP orders contain exactly one product.
type Order {
    id: ID!
    status: OrderStatus!
    totalAmountPaise: Int!
    product: Product!
    gatewayOrderId: String   # Razorpay "order_XXXX"; null for free products
    # Phase 09B D3 — which checkout to open. gatewayKeyId is the PUBLIC key id, only while PENDING.
    paymentProvider: String!
    gatewayKeyId: String
    failureReason: String    # latest declined attempt, if any
    createdAt: DateTime!
}

# PAY-10. Snapshotted at purchase time, so a future commission change never rewrites history.
type CreatorEarnings {
    salesCount: Long!
    grossSalesPaise: Long!
    platformFeePaise: Long!
    netEarningsPaise: Long!
}

# D1 — session lifecycle over GraphQL, tile bytes over REST (CLAUDE.md: GraphQL for data, REST
# for files). sessionToken is returned ONLY here, once — only its hash is stored (D2).
type ViewerSession {
    sessionId: ID!
    sessionToken: String!
    productId: ID!
    pageCount: Int
    heartbeatIntervalSeconds: Int!
    # Phase 16, D5 — the resolutions pages exist in, so the viewer can pick the smallest sharp one.
    tileVariants: [TileVariant!]!
    expiresAt: DateTime!
}

type TileVariant {
    name: String!
    widthPx: Int!
}

type ViewerHeartbeat {
    status: ViewerSessionStatus!
    expiresAt: DateTime!
}

# D5 — a single-use, ~30-second link to one watermarked tile, fetched via GET (REST), never
# through GraphQL itself (binary image bytes don't belong in a JSON response body).
type SignedPageUrl {
    url: String!
    expiresAt: DateTime!
    # V8 — the page's clickable links, overlaid on the canvas by the reader.
    links: [PageLink!]!
}

enum PageLinkType {
    URL    # external: http, https or mailto only
    PAGE   # another page of this document
}

# One clickable area on a page, as fractions (0..1) of the page image, origin top-left.
type PageLink {
    left: Float!
    top: Float!
    width: Float!
    height: Float!
    type: PageLinkType!
    url: String
    targetPage: Int
}

type Notification {
    id: ID!
    type: String!
    title: String!
    body: String
    isRead: Boolean!
    createdAt: DateTime!
}

# ── Inputs ────────────────────────────────────────────────────────────────────

input RegisterInput {
    email: String!
    password: String!
    displayName: String!
}

input LoginInput {
    email: String!
    password: String!
}

input BecomeCreatorInput {
    bio: String
    payoutEmail: String
    payoutUpi: String
}

input ProductFilterInput {
    categorySlug: String
    minPricePaise: Int
    maxPricePaise: Int
    isFree: Boolean
    searchQuery: String
    sortBy: String   # newest | popular | rating | price_asc | price_desc
    # MARKET-03 — only products whose average_rating >= this value. Products with no
    # reviews yet (average_rating IS NULL) never match a minRating filter.
    minRating: Float
}

input CreateProductInput {
    title: String!
    description: String!
    pricePaise: Int!
    categoryId: ID!
    tags: [String!]!
    freePreviewPages: Int!
}

# Exactly the three values Razorpay's checkout.js passes to its success handler, plus our order id.
input VerifyPaymentInput {
    orderId: ID!
    gatewayOrderId: String!      # razorpay_order_id
    gatewayPaymentId: String!    # razorpay_payment_id
    gatewaySignature: String!    # razorpay_signature = HMAC_SHA256(order_id|payment_id, key_secret)
}

input SubmitReviewInput {
    productId: ID!
    rating: Int!
    reviewText: String
}

# ── Queries ───────────────────────────────────────────────────────────────────

type Query {
    # Auth
    me: User

    # Phase 09B D8 — public: the demo banner needs it before login.
    platformInfo: PlatformInfo!

    # Marketplace
    products(filter: ProductFilterInput, page: Int = 0, size: Int = 20): ProductPage!
    product(id: ID!): Product
    categories: [Category!]!

    # Buyer
    order(id: ID!): Order
    # Phase 09C D5 — printable receipt, owner-only (someone else's order is NOT_FOUND)
    orderReceipt(orderId: ID!): OrderReceipt!
    myLibrary: [Entitlement!]!
    myNotifications: [Notification!]!
    # Phase 6, D7 — a one-time, ~30s Redis-backed ticket that authenticates the SSE stream
    # (EventSource can't send an Authorization header). Single-use: GETDEL on first connect.
    notificationStreamTicket: String!

    # Secure viewer (D1) — side-effect-free: signing a tile URL doesn't itself change any state.
    # Phase 16, D5 — variant is a name from ViewerSession.tileVariants (DESKTOP when omitted or unknown);
    # the variant is signed into the URL.
    viewerPageUrl(sessionToken: String!, pageNumber: Int!, variant: String = "DESKTOP"): SignedPageUrl!

    # Creator
    myProducts: [Product!]!
    # Phase 15, D7 — newest first. Owner-only: someone else's product is ACCESS_DENIED.
    productVersions(productId: ID!): [DocumentVersion!]!
    creatorEarnings: CreatorEarnings!
    # Phase 09C — payouts & statements (CREATOR-only; the creator is always the caller)
    creatorBalance: CreatorBalance!
    myPayouts: [Payout!]!
    myPayoutDetails: PayoutDetails!
    creatorStatement(month: String!): CreatorStatement!   # month = YYYY-MM

    # Reviews
    productReviews(productId: ID!, page: Int = 0, size: Int = 10): ReviewPage!
    myReview(productId: ID!): Review
    ratingBreakdown(productId: ID!): [RatingCount!]!
}

# ── Mutations ─────────────────────────────────────────────────────────────────

type Mutation {
    # Auth
    register(input: RegisterInput!): User!
    login(input: LoginInput!): AuthPayload!
    googleLogin(idToken: String!): AuthPayload!
    refreshToken(token: String!): AuthPayload!
    logout(refreshToken: String!): Boolean!
    becomeCreator(input: BecomeCreatorInput!): User!

    # Products (Creator)
    createProduct(input: CreateProductInput!): Product!
    unpublishProduct(id: ID!): Product!
    deleteProduct(id: ID!): Boolean!
    # Phase 6, D4 — state-transition recovery. Both are owner-only (object-level check in the
    # service) and throw INVALID_STATE_TRANSITION from any other starting status.
    # Phase 15, D2 — versionId (optional) targets one version's failed job; omit it for the Phase 6
    # meaning (the product's first upload FAILED).
    retryProcessing(productId: ID!, versionId: ID): Product!
    # Phase 15, D5 — soft-retire a version. Rejected while it is current, processing, or has buyers.
    retireDocumentVersion(productId: ID!, versionId: ID!): Boolean!
    republishProduct(productId: ID!): Product!

    # Commerce — idempotencyKey: a client-generated UUID per purchase attempt (Stripe pattern);
    # repeating the call with the same key returns the same order instead of creating another.
    initiateOrder(productId: ID!, idempotencyKey: String!): InitiateOrderPayload!
    verifyPayment(input: VerifyPaymentInput!): Order!

    # Secure viewer (D1) — these three mutate viewer_sessions / the Redis lease, so they're
    # mutations even though heartbeat/end return no domain object.
    startViewerSession(productId: ID!, deviceFingerprint: String!): ViewerSession!
    viewerHeartbeat(sessionToken: String!): ViewerHeartbeat!
    endViewerSession(sessionToken: String!): Boolean!

    # Phase 09C D2 — ask to be paid out of the available balance (paise)
    requestPayout(amountPaise: Long!): Payout!
    updatePayoutDetails(payoutUpi: String, payoutEmail: String): PayoutDetails!

    # Reviews
    submitReview(input: SubmitReviewInput!): Review!
    deleteMyReview(productId: ID!): Boolean!

    # Password reset (AUTH-07) — always returns true; never reveals whether the email exists.
    requestPasswordReset(email: String!): Boolean!
    resetPassword(token: String!, newPassword: String!): Boolean!

    # Notifications
    markNotificationRead(id: ID!): Boolean!
    markAllNotificationsRead: Int!   # returns how many rows were flipped to read
}

# ── Payload Types ─────────────────────────────────────────────────────────────

type AuthPayload {
    accessToken: String!
    refreshToken: String!
    user: User!
}

# Everything the browser needs to open the gateway's checkout. For free products the order is
# already COMPLETED and gatewayOrderId/gatewayKeyId are null.
type InitiateOrderPayload {
    order: Order!
    gatewayOrderId: String
    gatewayKeyId: String     # public key id (Razorpay "key"); never a secret
    currency: String!
    provider: String!        # MOCK | RAZORPAY (Phase 09B D3) — which checkout the browser opens
}

# Phase 09B D8 — MOCK: our simulator. TEST: real Razorpay, test keys, no money moves. LIVE: real money.
enum PaymentMode {
    MOCK
    TEST
    LIVE
}

type PlatformInfo {
    paymentMode: PaymentMode!
    supportEmail: String!
}

# ── Phase 09C — payouts, statements, receipts ────────────────────────────────

# D1 — derived from events on every read; nothing is stored.
type CreatorBalance {
    availablePaise: Long!          # cleared earnings − payouts that are not REJECTED
    pendingPaise: Long!            # earnings still inside the hold period
    lifetimeEarningsPaise: Long!   # all non-refunded earnings
    paidOutPaise: Long!            # payouts already PAID
}

enum PayoutStatus {
    REQUESTED
    APPROVED
    PROCESSING   # reserved for automated payouts; unused while payouts are manual
    PAID
    REJECTED
}

type Payout {
    id: ID!
    creatorId: ID!
    creatorName: String!
    creatorEmail: String!
    amountPaise: Long!
    status: PayoutStatus!
    grossRevenuePaise: Long!
    platformFeePaise: Long!
    netPayoutPaise: Long!
    payoutMethod: String
    payoutDestination: String
    payoutReference: String
    requestedAt: DateTime!
    processedAt: DateTime
    notes: String
}

type PayoutPage {
    content: [Payout!]!
    totalElements: Int!
    totalPages: Int!
    pageNumber: Int!
}

type PayoutDetails {
    payoutUpi: String
    payoutEmail: String
}

# D4 — amounts are SIGNED paise from the creator's view: sales positive, refunds/payouts negative.
type StatementLine {
    date: DateTime!
    type: String!          # SALE | REFUND | PAYOUT
    description: String!
    grossPaise: Long!
    feePaise: Long!
    netPaise: Long!
}

type CreatorStatement {
    month: String!
    lines: [StatementLine!]!
    grossSalesPaise: Long!
    refundsPaise: Long!
    platformFeePaise: Long!    # net of refunded fees
    netEarningsPaise: Long!    # sales net − refund net
    payoutsPaise: Long!        # PAID in the month
}

# D5 — the payment id is masked; only the last 4 characters survive.
type OrderReceipt {
    orderId: ID!
    status: OrderStatus!
    purchasedAt: DateTime!
    productTitle: String!
    creatorName: String!
    amountPaise: Long!
    paymentIdMasked: String
    paymentMode: PaymentMode!
}
