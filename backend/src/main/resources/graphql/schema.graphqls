# SecureLeaf — GraphQL Schema
# Split into logical files per module as the schema grows.
# Spring for GraphQL auto-discovers all .graphqls files under classpath:graphql/

# ── Scalars ──────────────────────────────────────────────────────────────────
scalar DateTime
scalar BigDecimal

# ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
    BUYER
    CREATOR
    ADMIN
}

enum EntitlementStatus {
    ACTIVE
    REVOKED
    EXPIRED
}


enum ProductStatus {
    DRAFT
    PROCESSING
    LIVE
    UNPUBLISHED
    FAILED
}

enum OrderStatus {
    PENDING
    COMPLETED
    FAILED
    REFUNDED
}

# ── Types ─────────────────────────────────────────────────────────────────────

type User {
    id: ID!
    email: String!
    displayName: String!
    roles: [UserRole!]!
    createdAt: DateTime!
}

type Product {
    id: ID!
    title: String!
    description: String!
    pricePaise: Int!
    status: ProductStatus!
    creator: User!
    category: Category!
    tags: [String!]!
    thumbnailUrl: String
    averageRating: Float
    totalSales: Int!
    freePreviewPages: Int!
    createdAt: DateTime!
}

type Category {
    id: ID!
    name: String!
    slug: String!
}

type ProductPage {
    content: [Product!]!
    totalElements: Int!
    totalPages: Int!
    pageNumber: Int!
}

type Review {
    id: ID!
    buyer: User!
    rating: Int!
    reviewText: String
    createdAt: DateTime!
}

type Entitlement {
    id: ID!
    product: Product!
    purchasedAt: DateTime!
    status: EntitlementStatus!
}

type Notification {
    id: ID!
    title: String!
    body: String
    isRead: Boolean!
    createdAt: DateTime!
}

# ── Inputs ────────────────────────────────────────────────────────────────────

input RegisterInput {
    email: String!
    password: String!
    displayName: String!
}

input LoginInput {
    email: String!
    password: String!
}

input BecomeCreatorInput {
    bio: String
    payoutEmail: String
    payoutUpi: String
}

input ProductFilterInput {
    categorySlug: String
    minPricePaise: Int
    maxPricePaise: Int
    isFree: Boolean
    searchQuery: String
    sortBy: String   # newest | popular | rating | price_asc | price_desc
}

input CreateProductInput {
    title: String!
    description: String!
    pricePaise: Int!
    categoryId: ID!
    tags: [String!]!
    freePreviewPages: Int!
}

input SubmitReviewInput {
    productId: ID!
    rating: Int!
    reviewText: String
}

# ── Queries ───────────────────────────────────────────────────────────────────

type Query {
    # Auth
    me: User

    # Marketplace
    products(filter: ProductFilterInput, page: Int = 0, size: Int = 20): ProductPage!
    product(id: ID!): Product

    # Buyer
    myLibrary: [Entitlement!]!
    myNotifications: [Notification!]!

    # Creator
    myProducts: [Product!]!

    # Reviews
    productReviews(productId: ID!, page: Int = 0, size: Int = 10): [Review!]!

    # Admin
    allUsers(page: Int = 0, size: Int = 50): [User!]!
    allProducts(page: Int = 0, size: Int = 50): [Product!]!
}

# ── Mutations ─────────────────────────────────────────────────────────────────

type Mutation {
    # Auth
    register(input: RegisterInput!): User!
    login(input: LoginInput!): AuthPayload!
    googleLogin(idToken: String!): AuthPayload!
    refreshToken(token: String!): AuthPayload!
    logout(refreshToken: String!): Boolean!
    becomeCreator(input: BecomeCreatorInput!): User!

    # Products (Creator)
    createProduct(input: CreateProductInput!): Product!
    unpublishProduct(id: ID!): Product!
    deleteProduct(id: ID!): Boolean!

    # Commerce
    initiateOrder(productId: ID!): InitiateOrderPayload!
    confirmMockPayment(orderId: ID!): Entitlement!

    # Reviews
    submitReview(input: SubmitReviewInput!): Review!

    # Notifications
    markNotificationRead(id: ID!): Boolean!

    # Admin
    suspendUser(userId: ID!): User!
    approveProduct(productId: ID!): Product!
    takeDownProduct(productId: ID!): Product!
}

# ── Payload Types ─────────────────────────────────────────────────────────────

type AuthPayload {
    accessToken: String!
    refreshToken: String!
    user: User!
}

type InitiateOrderPayload {
    orderId: ID!
    clientSecret: String   # For real payment gateway (Stripe/Razorpay); null for mock
}
