# SecureLeaf production environment — Phase 09D D10.
#
# Do NOT copy this by hand: run   infra/prod/scripts/generate-env.sh
# It writes infra/prod/.env (mode 600, git-ignored), generates every SECRET below with strong
# random values, and prompts for the EXTERNAL ones. The backend refuses to boot in the `prod`
# profile if a secret is empty, too short, or still a published dev default (ProdSecretsConfig).
#
# Lines marked [generated] are filled by the script; [ask] are prompted; [optional] may stay empty.

# ── Site ─────────────────────────────────────────────────────────────────────
SITE_HOST=                    # [ask] e.g. secureleaf.duckdns.org — Caddy gets a Let's Encrypt cert for it
ADMIN_EMAILS=                 # [ask] comma-separated emails granted ADMIN
SUPPORT_EMAIL=                # [ask] shown in the UI
HTTP_PORT=80                  # host ports Caddy publishes (only Caddy publishes any)
HTTPS_PORT=443

# ── Secrets — [generated] ────────────────────────────────────────────────────
DB_PASSWORD=
JWT_SECRET=                   # >= 256 bits
DRM_SIGNING_SECRET=           # >= 256 bits
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
REDIS_PASSWORD=

# ── Google sign-in ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=             # [ask] leave empty to disable Google sign-in

# ── Razorpay (TEST mode until Phase 18) ──────────────────────────────────────
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=              # [ask] rzp_test_...
RAZORPAY_KEY_SECRET=          # [ask]
RAZORPAY_WEBHOOK_SECRET=      # [ask]

# ── Email via Brevo (D7) ─────────────────────────────────────────────────────
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=                    # [ask] your Brevo SMTP login
MAIL_PASS=                    # [ask] your Brevo SMTP key
MAIL_FROM=                    # [ask] MUST be a sender verified in Brevo

# ── Error monitoring (optional, D8) ──────────────────────────────────────────
SENTRY_DSN=                   # [optional] backend
VITE_SENTRY_DSN=              # [optional] frontend (baked into the build)
VITE_LEGAL_REVIEWED=          # leave empty until the legal text is reviewed (Phase 18)

# ── Backups to Oracle Object Storage, S3-compatible (D12) ────────────────────
OCI_S3_ENDPOINT=              # [ask] https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_BUCKET=                # [ask] e.g. secureleaf-backups
OCI_S3_ACCESS_KEY=            # [ask] a "customer secret key" pair
OCI_S3_SECRET_KEY=            # [ask]
BACKUP_BUCKETS="secureleaf-raw secureleaf-tiles secureleaf-thumbnails"

# ── Images (override only if a registry is unreachable) ──────────────────────
MINIO_IMAGE=quay.io/minio/minio:latest
MC_IMAGE=quay.io/minio/mc:latest
