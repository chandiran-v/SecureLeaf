    {
      "id": 17,
      "type": "timeseries",
      "title": "Threads: render pool, queue, JVM",
      "description": "Phase 17. USE method, saturation. Busy render threads against the pool size, and the queue behind them (a queue that stays above 0 means requests wait). Tomcat itself runs on virtual threads, so its busy-thread gauge is not meaningful; live platform threads show pool growth.",
      "datasource": {
        "type": "prometheus",
        "uid": "secureleaf-prometheus"
      },
