        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "sum(rate(jvm_gc_pause_seconds_sum[1m]))",
          "legendFormat": "pause s/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "sum(rate(jvm_gc_pause_seconds_count[1m]))",
          "legendFormat": "pauses/s"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Active viewer sessions",
      "description": "Sessions not yet ended (active or lapsed but not yet swept).",
      "datasource": {
        "type": "prometheus",
        "uid": "secureleaf-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
