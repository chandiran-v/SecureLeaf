        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "secureleaf_viewer_sessions_active",
          "legendFormat": "sessions"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tile size (avg bytes)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "secureleaf-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "sum(rate(secureleaf_tile_bytes_sum[1m])) / sum(rate(secureleaf_tile_bytes_count[1m]))",
          "legendFormat": "avg bytes/tile"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "sum(rate(secureleaf_tile_bytes_sum[1m]))",
          "legendFormat": "bytes/s out"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Render pool: queue depth vs busy threads",
      "description": "Phase 12 bulkhead. Queue > 0 means renders are waiting for a tile-render- thread; a queue pinned at its capacity means new tiles are being shed with 503.",
      "datasource": {
        "type": "prometheus",
        "uid": "secureleaf-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "secureleaf_render_queue_size",
          "legendFormat": "queued"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "secureleaf_render_active",
          "legendFormat": "rendering (busy threads)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Render queue wait p95 and load shed/s",
      "description": "Time a tile waited for a render thread (p95), and tiles per second refused (queue full -> 503) or abandoned (timeout).",
      "datasource": {
        "type": "prometheus",
        "uid": "secureleaf-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(secureleaf_render_wait_seconds_bucket[1m])))",
          "legendFormat": "queue wait p95 (s)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "sum(rate(secureleaf_render_rejected_total[1m]))",
          "legendFormat": "rejected/s (queue full)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "sum(rate(secureleaf_render_timeout_total[1m]))",
          "legendFormat": "timed out/s"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tile cache hit rate",
      "description": "Phase 13. Share of authorised tile requests served from the watermarked-tile cache (no storage fetch, no render). Hits and misses per second underneath.",
      "datasource": {
        "type": "prometheus",
        "uid": "secureleaf-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "sum(rate(secureleaf_tilecache_hit_total[1m])) / clamp_min(sum(rate(secureleaf_tilecache_hit_total[1m])) + sum(rate(secureleaf_tilecache_miss_total[1m])), 0.001)",
          "legendFormat": "hit rate"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "sum(rate(secureleaf_tilecache_hit_total[1m]))",
          "legendFormat": "hits/s"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "sum(rate(secureleaf_tilecache_miss_total[1m]))",
          "legendFormat": "misses/s"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tile cache size and evictions",
      "description": "Phase 13. Bytes held by the disk cache and entries removed per second by reason (expired = TTL, size = bound reached, explicit = revocation/suspension).",
      "datasource": {
        "type": "prometheus",
        "uid": "secureleaf-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "secureleaf_tilecache_size_bytes",
          "legendFormat": "cache size (bytes)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "secureleaf-prometheus"
          },
          "expr": "sum by (reason) (rate(secureleaf_tilecache_evictions_total[1m]))",
          "legendFormat": "evictions/s {{reason}}"
        }
      ]
    }
  ],
